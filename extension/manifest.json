{
  "manifest_version": 3,
  "name": "Eng2Kor Flow - 영한 자동 변환",
  "version": "1.0.1",
  "description": "영문 자판으로 잘못 친 한글을 입력하는 도중에 자동으로 바꿔 줍니다. 예: dkssud → 안녕",
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  },
  "minimum_chrome_version": "114",
  "permissions": ["storage"],
  "action": {
    "default_title": "Eng2Kor Flow",
    "default_popup": "popup/popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png"
    }
  },
  "content_scripts": [
    {
      "matches": ["http://*/*", "https://*/*"],
      "js": ["src/words.js", "src/hangul.js", "src/preview.js", "src/content.js"],
      "run_at": "document_start",
      "all_frames": true,
      "match_about_blank": true
    },
    {
      "matches": ["https://colab.research.google.com/*"],
      "js": ["src/monaco.js"],
      "run_at": "document_start",
      "world": "MAIN"
    }
  ]
}
